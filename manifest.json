{
  "manifest_version": 3,
  "name": "WA Media Downloader Clone",
  "description": "Adds one-click media download buttons to WhatsApp Web messages.",
  "version": "0.1.0",
  "action": {
    "default_title": "WA Media Downloader",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
